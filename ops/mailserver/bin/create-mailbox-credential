#!/bin/sh
set -eu

password_file=/root/info-mailbox-initial-password
users_file=/etc/dovecot/users

if [ "${1:-}" = "--test" ]; then
    password="$(cat "$password_file")"
    password_hash="$(cut -d: -f2- "$users_file")"
    /usr/bin/doveadm pw -t "$password_hash" -p "$password" >/dev/null
    /usr/bin/doveadm auth test info@sveevee.co.il "$password" >/dev/null
    printf '%s\n' 'Mailbox credential verified'
    exit 0
fi

if [ -s "$users_file" ] && [ "${1:-}" != "--regenerate" ]; then
    exit 0
fi

umask 077
password="$(openssl rand -hex 20)"
password_hash="$(printf '%s\n%s\n' "$password" "$password" | /usr/bin/doveadm pw -s ARGON2ID)"

printf '%s\n' "$password" > "$password_file"
printf 'info@sveevee.co.il:%s\n' "$password_hash" > "$users_file"
chown root:dovecot "$users_file"
chmod 0640 "$users_file"
