{
  "name": "sveevee-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:seo": "npm run build && cd ../backend && php artisan seo:prerender-public-pages",
    "optimize:landing-images": "node scripts/optimize-landing-images.mjs",
    "preview": "vite preview",
    "lint:i18n": "node scripts/audit-i18n.mjs",
    "lint": "npm run lint:i18n && eslint -c .eslintrc.cjs src vite.config.js --ext .js,.vue",
    "lint:fix": "eslint -c .eslintrc.cjs src vite.config.js --ext .js,.vue --fix"
  },
  "dependencies": {
    "@hebcal/cities": "^6.1.0",
    "@quasar/extras": "^2.0.0",
    "axios": "^1.16.1",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.10.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "sass-embedded": "^1.93.2",
    "sharp": "^0.35.3",
    "vite": "^8.0.12",
    "vue-eslint-parser": "^9.4.3"
  }
}
